LEAGUE_ID=

# Supabase
# Local dev: URL and keys are printed by `supabase status`.
# Production: hosted project dashboard, Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only (sb_secret_...). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
